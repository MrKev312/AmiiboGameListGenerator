<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Version>1.4.0</Version>
		<Authors>MrKev312</Authors>
		<NeutralLanguage>en</NeutralLanguage>
		<LangVersion>latest</LangVersion>
		<PackageProjectUrl>https://github.com/MrKev312/AmiiboGameListGenerator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MrKev312/AmiiboGameListGenerator</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup>
		<CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\WiiU.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" Version="1.11.43" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\WiiU.json" />
	</ItemGroup>
</Project>
